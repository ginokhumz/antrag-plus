{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm ci*)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx tsx*)",
      "Bash(npx tsc*)",
      "Bash(npx vitest*)",
      "Bash(node *)",
      "Bash(jq *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "WebFetch(domain:www.aktion-mensch.de)"
    ],
    "ask": [
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push*)",
      "Bash(gh *)",
      "Bash(npm install*)",
      "Bash(git commit*)"
    ],
    "deny": [
      "Bash(npm publish*)",
      "Bash(rm -rf *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "www.aktion-mensch.de",
        "registry.npmjs.org"
      ]
    }
  }
}
