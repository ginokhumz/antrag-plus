{
  "name": "antrag-plus",
  "version": "1.0.0",
  "scripts": {
    "test": "vitest run",
    "scrape": "tsx scraper/run.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts web",
    "dev": "npm-run-all --parallel dev:api dev:web",
    "verify:live": "tsx scraper/verifyLive.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ginokhumz/antrag-plus.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/ginokhumz/antrag-plus/issues"
  },
  "homepage": "https://github.com/ginokhumz/antrag-plus#readme",
  "private": true,
  "workspaces": [
    "schema",
    "scraper",
    "server",
    "web"
  ],
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "npm-run-all": "^4.1.5",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  }
}
